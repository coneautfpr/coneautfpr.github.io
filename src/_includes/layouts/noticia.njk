---
layout: layouts/base.njk
---
<article class="noticia">
	<header class="noticia-cabecalho">
		<p class="voltar"><a href="/noticias/">← Todas as notícias</a></p>
		<h1>{{ title }}</h1>
		<p class="data"><time datetime="{{ page.date | dataISO }}">{{ page.date | dataBR }}</time></p>
		<p class="resumo">{{ resumo }}</p>
	</header>
	<figure class="capa">
		<img src="capa.webp" alt="{{ resumo }}">
		{%- if legenda %}<figcaption>{{ legenda | safe }}</figcaption>{% endif %}
	</figure>
	<div class="texto">
		{{ content | safe }}
	</div>
</article>
